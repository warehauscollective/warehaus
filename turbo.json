{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "tokens": {
      "outputs": ["dist/tokens.css"]
    },
    "build": {
      "dependsOn": ["^build", "tokens"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build", "tokens"]
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "build-storybook": {
      "dependsOn": ["tokens"],
      "outputs": ["storybook-static/**"]
    }
  }
}
