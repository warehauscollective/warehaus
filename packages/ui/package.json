{
  "name": "@warehaus/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Warehaus brand UI — Bevel, typography, logo, swipe-tab shell, and shared brand CSS. Single source of truth for website + portal.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./bevel-inspector": {
      "types": "./src/bevel-inspector.tsx",
      "default": "./src/bevel-inspector.tsx"
    },
    "./styles/brand.css": "./src/styles/brand.css"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@warehaus/typescript-config": "*",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3"
  }
}
