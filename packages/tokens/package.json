    "./css": "./dist/tokens.css"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "tokens": "node scripts/build-css.mjs",
    "build": "node scripts/build-css.mjs",
    "prepare": "node scripts/build-css.mjs"
  }
}
