{
  "name": "@warehaus/tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Warehaus design tokens — platform-agnostic source of truth (web CSS vars + JS for native).",
  "type": "module",
  "main": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
