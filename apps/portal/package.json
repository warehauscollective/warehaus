{
  "name": "@warehaus/portal",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/dev-app.mjs portal",
    "dev:webpack": "node ../../scripts/ensure-port.mjs ${PORTAL_PORT:-3100} @warehaus/portal && next dev --port ${PORTAL_PORT:-3100}",
    "dev:convex": "convex dev",
    "prebuild": "npm run tokens -w @warehaus/tokens",
    "build": "next build",
    "start": "next start --port ${PORTAL_PORT:-3100}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:convex-lib": "node --import tsx --test convex/_lib/**/*.test.ts"
  },
  "dependencies": {
    "@convex-dev/better-auth": "^0.12.5",
    "@notionhq/client": "^5.23.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@vercel/blob": "^2.6.1",
    "@warehaus/logic": "*",
    "@warehaus/portal-sync": "*",
    "@warehaus/tokens": "*",
    "@warehaus/ui": "*",
    "better-auth": "~1.6.15",
    "clsx": "^2.1.1",
    "convex": "^1.43.0",
    "convex-helpers": "^0.1.120",
    "lucide-react": "^0.563.0",
    "next": "^15.3.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.4",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@warehaus/typescript-config": "*",
    "eslint": "^9.39.3",
    "eslint-config-next": "^15.3.3",
    "typescript": "^5.9.3"
  }
}
