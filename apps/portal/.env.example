# --- Convex (portal SoT; separate deployment from Motoko) ---
# Populate after `npm run dev:convex -w @warehaus/portal` provisions the project.
# Cloud Agents: prefer `bash scripts/portal-cloud-bootstrap.sh` (vercel env pull).
# CONVEX_DEPLOYMENT=dev:your-deployment
# NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
# NEXT_PUBLIC_SITE_URL=http://localhost:3100
# BETTER_AUTH_SECRET=
# SITE_URL=http://localhost:3100

# --- Cloud Agent / local QA test logins (seed via scripts/ensure-portal-test-auth.mjs) ---
# Client: demo@northbay.test / WarehausDemo1!
# Staff:  team@warehaus.co / WarehausTeam1!
# PORTAL_TEST_EMAIL=demo@northbay.test
# PORTAL_TEST_PASSWORD=WarehausDemo1!
# PORTAL_STAFF_EMAIL=team@warehaus.co
# PORTAL_STAFF_PASSWORD=WarehausTeam1!

# --- Vercel Blob (Notion → Shared Resources / Doc images) ---
# Also set on the Convex deployment (npx convex env set BLOB_READ_WRITE_TOKEN …)
# BLOB_READ_WRITE_TOKEN=

# Notion sync (set the same token on Convex: npx convex env set NOTION_WAREHAUS_TOKEN …)
# NOTION_WEBHOOK_SECRET=  # optional; used by /api/notion/webhook and Convex /notion/webhook
NOTION_WAREHAUS_TOKEN=

# --- Stripe billing (Convex only — never Notion) ---
# Set on the Convex deployment (see docs/planning/portal-convex/ops-checklist.md):
#   npx convex env set STRIPE_WEBHOOK_SECRET whsec_…
#   npx convex env set STRIPE_SECRET_KEY sk_test_…   # optional until Checkout/Portal
# Webhook URL: ${NEXT_PUBLIC_CONVEX_SITE_URL}/stripe/webhook
# Local without keys: npx convex run seed:seedDemoBilling
# STRIPE_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=

# Ops: also set BLOB_READ_WRITE_TOKEN on Convex for Shared Resource + Client Doc image copy.
# Full env list: docs/planning/portal-convex/ops-checklist.md

# Multi-tenant hosts (comma-separated). Team = portal.{root} or apex; client = {slug}.{root}
ROOT_DOMAINS=warehaus.vercel.app,warehaus.co,localhost
TEAM_SUBDOMAIN=portal

# Optional debug overrides (local only):
# PORTAL_TENANT_MODE=team
# PORTAL_TENANT_MODE=client
# PORTAL_CLIENT_SLUG=client-portal
# PORTAL_CLIENT_ID=CLI-001
