# Names only. No values in this file.
# Two Convex environments:
# - production unique-turtle-383 (never put that name in .env.local)
# - one shared dev deployment for Peter's Mac and cloud agents
# Copy to apps/portal/.env.local. Do not commit .env.local.

CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
NEXT_PUBLIC_SITE_URL=
SITE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
CONVEX_SITE_URL=
CONVEX_CLOUD_URL=

# Dev deployment only. Peter creates this key. Never commit a value.
CONVEX_DEPLOY_KEY=

# Fixture preview (npm run dev:portal:local). Leave unset when using Convex.
NEXT_PUBLIC_PORTAL_FIXTURES=

# Read-only Notion token on the shared dev deployment. Leave write flags unset here.
# Team invites read these from the shared dev Convex deployment, not from Next.
# Set them there with `npx convex env set`. Exact "true" is on. Never set them
# on production unique-turtle-383. Do not put values in this file.
# Optional Granola API key. When unset, import does not call Granola and does not
# write fixture notes. Never commit a value. Do not set this on production
# unique-turtle-383 from this file.
GRANOLA_API_KEY=

NOTION_WAREHAUS_TOKEN=
NOTION_WEBHOOK_SECRET=
NOTION_PROJECT_CREATE_ENABLED=
NOTION_WRITEBACK_ENABLED=
INVITE_EMAIL_ENABLED=
PORTAL_PUBLIC_URL=
# Convex clients id of the Warehaus row that stores the real Notion page uuid.
# Chooses that row when more than one Warehaus row has a uuid. Not a page id.
# Leave unset here. Do not set this on production unique-turtle-383 from this file.
WAREHAUS_INTERNAL_CLIENT_ID=

BLOB_READ_WRITE_TOKEN=
RESEND_API_KEY=
# Required. Warehaus Portal <portal@warehaus.studio> via EMAIL_FROM.
EMAIL_FROM=
EMAIL_REPLY_TO=
STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=

# Host routing. Empty uses the defaults in src/lib/auth/tenancy.ts.
ROOT_DOMAINS=
TEAM_SUBDOMAIN=
PORTAL_TENANT_MODE=
PORTAL_CLIENT_SLUG=
PORTAL_CLIENT_ID=
