# Names only. No values in this file.
# Two Convex environments:
# - production unique-turtle-383 (never put that name in .env.local)
# - one shared dev deployment for Peter's Mac and cloud agents
# Copy to apps/portal/.env.local. Do not commit .env.local.

CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
NEXT_PUBLIC_SITE_URL=
SITE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
CONVEX_SITE_URL=
CONVEX_CLOUD_URL=

# Dev deployment only. Peter creates this key. Never commit a value.
CONVEX_DEPLOY_KEY=

# Fixture preview (npm run dev:portal:local). Leave unset when using Convex.
NEXT_PUBLIC_PORTAL_FIXTURES=

# Read-only Notion token on the shared dev deployment. Leave write flags unset.
NOTION_WAREHAUS_TOKEN=
NOTION_WEBHOOK_SECRET=
NOTION_PROJECT_CREATE_ENABLED=
NOTION_WRITEBACK_ENABLED=

BLOB_READ_WRITE_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=

# Host routing. Empty uses the defaults in src/lib/auth/tenancy.ts.
ROOT_DOMAINS=
TEAM_SUBDOMAIN=
PORTAL_TENANT_MODE=
PORTAL_CLIENT_SLUG=
PORTAL_CLIENT_ID=
