{
  "name": "warehaus",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@warehaus/web",
    "dev:web": "turbo run dev --filter=@warehaus/web",
    "dev:portal": "node scripts/preflight-portal-dev.mjs && turbo run dev --filter=@warehaus/portal",
    "dev:portal:local": "NEXT_PUBLIC_PORTAL_FIXTURES=1 turbo run dev --filter=@warehaus/portal",
    "dev:convex": "npm run dev:convex -w @warehaus/portal",
    "dev:local": "node scripts/dev-local.mjs",
    "test:preflight": "node --test scripts/preflight-portal-dev.test.mjs",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@warehaus/web",
    "build:portal": "turbo run build --filter=@warehaus/portal",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "tokens": "turbo run tokens --filter=@warehaus/tokens",
    "storybook": "turbo run storybook --filter=@warehaus/web",
    "build-storybook": "turbo run build-storybook --filter=@warehaus/web",
    "notion:bootstrap": "node scripts/notion-bootstrap-warehaus.mjs",
    "test:portal-sync": "npm run test -w @warehaus/portal-sync",
    "test:portal-convex": "npm run test:convex-lib -w @warehaus/portal"
  },
  "devDependencies": {
    "turbo": "^2.5.4"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.7"
}
