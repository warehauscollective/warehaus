{
  "name": "warehaus",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @warehaus/web",
    "build": "npm run build -w @warehaus/web",
    "start": "npm run start -w @warehaus/web",
    "lint": "npm run lint -w @warehaus/web",
    "typecheck": "npm run typecheck -w @warehaus/web",
    "tokens": "npm run tokens -w @warehaus/web",
    "storybook": "npm run storybook -w @warehaus/web",
    "build-storybook": "npm run build-storybook -w @warehaus/web"
  }
}
